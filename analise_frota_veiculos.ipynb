   "source": [
    "# Seu código aqui\n",
    "# transformando a data em datetime\n",
    "df_frota['Data'] = pd.to_datetime(df_frota['Data'])\n",
    "\n",
    "# criando as colunas dia, mes e ano\n",
    "df_frota['Dia'] = df_frota['Data'].dt.day\n",
    "df_frota['Mes'] = df_frota['Data'].dt.month\n",
    "df_frota['Ano'] = df_frota['Data'].dt.year\n",
    "\n",
    "# criando colunas consumo medio e custo/km\n",
    "df_frota['Consumo Km/L'] = df_frota['KM_Rodado'] / df_frota['Litros_Combustivel']\n",
    "df_frota['Custo/KM'] = df_frota['Custo_Manutencao'] / df_frota['KM_Rodado']\n",
    "display(df_frota)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 📊 Análise Exploratória"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4.1 Quilometragem por mês/veículo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# grafico km por mes\n",
    "km_por_veiculo = df_frota.groupby(['Ano', 'Mes', 'ID_Veiculo'])['KM_Rodado'].sum().reset_index()\n",
    "km_por_veiculo['Data'] = pd.to_datetime(\n",
    "    km_por_veiculo.rename(columns={'Ano': 'year', 'Mes': 'month'})[['year', 'month']].assign(day=1)\n",
    ")\n",
    "sns.lineplot(data=km_por_veiculo, x='Data', y='KM_Rodado')\n",
    "plt.title(f'KM rodado por mês')\n",
    "plt.xlabel('Data')\n",
    "plt.ylabel('KM Rodado')\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
