   "source": [
    "## Eficiência dos veículos \n",
    "# 1 - Agrupar por tipo de veículo e ver o custo médio por km\n",
    "custo_por_veiculo = df_frota.groupby('ID_Veiculo')['Custo/KM'].mean().reset_index()\n",
    "\n",
    "# 2 - ordenar os mais economicos\n",
    "custo_por_veiculo = custo_por_veiculo.sort_values(by='Custo/KM')\n",
    "\n",
    "# 3 - exibir\n",
    "display(custo_por_veiculo)\n",
    "\n",
    "# 4 - Grafico melhores veiculos\n",
    "sns.barplot(data=custo_por_veiculo.head(10), x='ID_Veiculo', y='Custo/KM')\n",
    "plt.title('Melhor Custo Médio por KM - Veículo')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
