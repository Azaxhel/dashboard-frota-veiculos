    "plt.title('Custo Total de Manutenção por Mês')\n",
    "plt.xlabel('Data')\n",
    "plt.ylabel('R$ Gasto com Manutenção')\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
